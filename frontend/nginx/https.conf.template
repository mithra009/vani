# Production: HTTPS with a Let's Encrypt certificate for ${PUBLIC_HOST} (set in .env).
# nginx's entrypoint fills in ${PUBLIC_HOST} and writes this to conf.d/default.conf at start-up.
# The certificate is issued and renewed on the server by certbot (README > HTTPS).

server {
    listen 80;
    server_name _;
    server_tokens off;
    return 301 https://${PUBLIC_HOST}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/vani-app.conf;
}
